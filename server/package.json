{
  "name": "ai-office-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "test": "node node_modules/tsx/dist/cli.mjs --test src/index.test.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "check": "tsc --noEmit && npm test",
    "check:hermes": "node node_modules/tsx/dist/cli.mjs check-error.mts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
