# Copy to .env. Never commit .env.
HOST=127.0.0.1
PORT=4317
# Artifact hasil kerja agent disajikan dari origin terpisah (default: PORT + 1)
# supaya HTML buatan agent tidak bisa memanggil API sebagai same-origin.
ARTIFACT_PORT=4318
ARTIFACT_HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Opsional. Bila diisi, semua /api/* wajib header "Authorization: Bearer <token>".
# Kosongkan hanya bila HOST loopback (server menolak host non-loopback tanpa token).
AI_OFFICE_TOKEN=
AI_OFFICE_DB=./data/ai-office.sqlite
# Folder hasil kerja agent per tugas: <root>/<taskId>/
AI_OFFICE_WORKSPACE=./workspace
AI_OFFICE_ENABLE_HERMES_READONLY=0
# Pemilik dokumen knowledge base; ditentukan server, bukan query param.
AI_OFFICE_OWNER=local
# Endpoint demo /tasks/:id/demo-run memalsukan penyelesaian task; mati secara default.
AI_OFFICE_ENABLE_DEMO=0
HERMES_BIN=hermes
# Kosongkan untuk memakai model default profil Hermes. Wajib diisi bila
# HERMES_READONLY_STRICT=1 (mode --safe-mode tidak membaca config profil).
HERMES_MODEL=
HERMES_PROVIDER=
# 1 = paksa --safe-mode (paling ketat, tapi gagal pada instalasi dengan provider
# kustom karena --safe-mode mengabaikan config.yaml). 0 = tanpa toolset bawaan (-t "")
# dan berjalan di folder sekali pakai.
HERMES_READONLY_STRICT=0
# Naikkan bila agent butuh waktu > 15 menit per subtugas.
HERMES_TIMEOUT_MS=1800000
