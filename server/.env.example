# Copy to .env. Never commit .env.
HOST=127.0.0.1
PORT=4317
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AI_OFFICE_DB=./data/ai-office.sqlite
# Folder hasil kerja agent per tugas: <root>/<taskId>/
AI_OFFICE_WORKSPACE=./workspace
AI_OFFICE_ENABLE_HERMES_READONLY=0
HERMES_BIN=hermes
HERMES_MODEL=
# Naikkan bila agent butuh waktu > 15 menit per subtugas.
HERMES_TIMEOUT_MS=1800000
